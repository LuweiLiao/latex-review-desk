{
  "name": "latex-review-desk",
  "version": "0.2.0",
  "private": true,
  "description": "本地 LaTeX 审阅台：PDF/源码对照阅读、批注、按 skill 润色，经 MCP 交给后台 agent 处理，修改方案在网页对照确认后才写入",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "postinstall": "node scripts/build.js",
    "start": "node scripts/build.js && node server/index.js",
    "serve": "node server/index.js",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/mcp-smoke.js",
    "demo": "node scripts/build.js && node -e \"process.env.THESIS_REVIEW_CONFIG='examples/demo/config.json';import('./server/index.js')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^6.5.438"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuweiLiao/latex-review-desk.git"
  },
  "engines": {
    "node": ">=22.13"
  }
}
