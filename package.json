{
  "name": "latex-review-desk",
  "version": "0.3.0",
  "description": "Multi-project local LaTeX review with direct OpenAI, Anthropic and Gemini APIs, PDF/source comparison, annotations and confirmed edits.",
  "type": "module",
  "bin": {
    "latex-review-desk": "bin/latex-review-desk.js"
  },
  "files": [
    "bin/",
    "server/",
    "web/index.html",
    "web/style.css",
    "web/lib/",
    "web/dist/app.js",
    "web/vendor/",
    "skills/",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "node scripts/build.js --minify",
    "start": "node bin/latex-review-desk.js",
    "serve": "node server/index.js",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/mcp-smoke.js",
    "demo": "node bin/latex-review-desk.js --config examples/demo/config.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^6.5.438"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuweiLiao/latex-review-desk.git"
  },
  "engines": {
    "node": ">=22.13"
  }
}
